# Required by the current application
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# Required deployment paths. DAIRN_BOOK_PATH is an in-container path under /books,
# never the host path (for example: /books/reviewer-book.dairn).
DAIRN_BOOKS_DIR=
DAIRN_BOOK_PATH=

# Optional model overrides; both default to gpt-4.1-mini when unset.
OPENAI_VISION_MODEL=
OPENAI_NARRATOR_MODEL=
